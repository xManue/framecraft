{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Framecraft",
  "version": "0.1.0",
  "identifier": "com.framecraft.editor",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Framecraft",
        "width": 1500,
        "height": 940,
        "minWidth": 980,
        "minHeight": 680,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../scripts/framecraft-vite-plugin.mjs": "scripts/framecraft-vite-plugin.mjs",
      "../scripts/framecraft-snap.mjs": "scripts/framecraft-snap.mjs",
      "../scripts/framecraft-picking.mjs": "scripts/framecraft-picking.mjs",
      "../scripts/hmi-property-flashing.mjs": "scripts/hmi-property-flashing.mjs",
      "../scripts/hmi-alarm-control.mjs": "scripts/hmi-alarm-control.mjs",
      "../scripts/hmi-alarm-summary.mjs": "scripts/hmi-alarm-summary.mjs",
      "../scripts/hmi-alarm-preview-surface.mjs": "scripts/hmi-alarm-preview-surface.mjs",
      "../scripts/hmi-faceplate-visuals.mjs": "scripts/hmi-faceplate-visuals.mjs",
      "../scripts/hmi-faceplate-preview.mjs": "scripts/hmi-faceplate-preview.mjs",
      "../scripts/editor-shortcuts.mjs": "scripts/editor-shortcuts.mjs",
      "../scripts/hmi-trend.mjs": "scripts/hmi-trend.mjs",
      "../scripts/hmi-function-trend.mjs": "scripts/hmi-function-trend.mjs",
      "../scripts/hmi-trend-runtime-ui.mjs": "scripts/hmi-trend-runtime-ui.mjs",
      "../scripts/hmi-trend-preview.mjs": "scripts/hmi-trend-preview.mjs",
      "../runtime/alarm-labels.mjs": "runtime/alarm-labels.mjs"
    }
  }
}
